# Coral Reef Health & Disease Monitoring System
# Research Project Environment Configuration

# FastAPI Backend Base URL
VITE_API_BASE_URL=http://localhost:8000

# Default Operating Mode ('MOCK' or 'LIVE')
VITE_DEFAULT_API_MODE=MOCK

# Model Prediction Endpoint
VITE_MODEL_PREDICTION_ENDPOINT=/api/v1/predict

# Backend Health Check Endpoint
VITE_HEALTH_ENDPOINT=/health

# Default Detection Confidence Threshold (0.0 to 1.0)
VITE_CONFIDENCE_THRESHOLD=0.40
